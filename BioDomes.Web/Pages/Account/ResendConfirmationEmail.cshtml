@page
@model BioDomes.Web.Pages.Account.ResendConfirmationEmailModel

@{
    ViewData["Title"] = "Renvoyer le lien de confirmation";
}

<section class="rounded-4 m-auto p-4" style="background-color: aliceblue; width: 40%">

    <h1 class="title text-center mb-4">Renvoyer le lien</h1>

    @if (Model.IsSuccess == true)
    {
        <div class="d-flex flex-column align-items-center gap-3">

            <div class="rounded-circle d-flex align-items-center justify-content-center bg-success bg-opacity-10 border border-success"
                 style="width:72px; height:72px;">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none"
                     stroke="#198754" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 2 11 13"/>
                    <path d="M22 2 15 22 11 13 2 9l20-7z"/>
                </svg>
            </div>

            <div class="alert alert-success w-100 text-center mb-0" role="alert">
                @Model.StatusMessage
            </div>

            <a asp-page="/Account/Login" class="btn btn-outline-secondary mt-1">
                Retour à la connexion
            </a>

        </div>
    }
    else
    {
        <form method="post" class="d-flex flex-column m-auto w-75 mt-3 gap-2">

            <div asp-validation-summary="All" class="text-danger"></div>

            <p class="text-muted text-center small mb-1">
                Saisis ton adresse e-mail et nous t'enverrons un nouveau lien d'activation.
            </p>

            <div class="d-flex flex-column">
                <label for="Email" class="form-label">Adresse e-mail</label>
                <input type="email"
                       id="Email"
                       name="Email"
                       class="form-control"
                       placeholder="ton@email.com"
                       required />
            </div>

            <button type="submit" class="btn btn-primary mt-2">
                Envoyer le lien
            </button>

            <div class="text-center mt-1">
                <a asp-page="/Account/Login" class="text-muted small">Retour à la connexion</a>
            </div>

        </form>
    }

</section>
