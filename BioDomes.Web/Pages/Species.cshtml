@page
@model BioDomes.Web.Pages.SpeciesModel

@{
    ViewData["Title"] = "Species";
}

<h1>Les espèces</h1>

<div class="container">
    <div class="row">
        @foreach (var espece in Model.especes)
        {
            <div class="col-md-4">
                <partial name="_SpeciesCard" model="espece" />
            </div>
        }
    </div>
</div>