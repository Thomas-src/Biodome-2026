@using System.Text.Json
@using BioDomes.Domains.Extensions
@model BioDomes.Web.Pages.Biodomes.DetailsModel

<div class="row g-0 border-top">
    <div class="p-4 border-end">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Statistiques</h5>
            <button class="btn btn-sm btn-outline-primary" type="button" onclick="exportAllChartsPDF()">
                Exporter le rapport
            </button>
        </div>
        <div style="width: 100%; margin: 30px auto;">
            <div id="chart4-detail" style="display:none; padding: 10px 14px; background: #f5f5f5; border-left: 4px solid #4e79a7; border-radius: 6px; margin-bottom: 12px; font-size: 0.9rem;"></div>
            <div style="position: relative; height: 400px; width: 100%;">
                <canvas id="speciesChart"></canvas>
            </div>
        </div>
        <div style="width: 100%; max-width: 400px; margin: 30px auto;">
            <canvas id="classificationChart"></canvas>
        </div>
        <div style="width: 100%; max-width: 400px; margin: 30px auto;">
            <canvas id="regimChart"></canvas>
        </div>
        <div style="width: 100%; height: 500px; margin: 30px auto;">
            <canvas id="foodChainChart"></canvas>
        </div>
    </div>
</div>
