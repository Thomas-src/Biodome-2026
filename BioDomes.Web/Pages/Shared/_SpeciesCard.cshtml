@model BioDomes.Domains.Core.Species
    <div class="d-flex row justify-content-start gap-4">

        <div class="w-50">
            <div class="card-body">
                <h5 class="card-title">@Model.Nom</h5>
                <p class="card-text mb-1">
                    <strong>Type :</strong> @Model.SpeciesClassification
                </p>
                <p class="card-text mb-1">
                    <strong>Régime :</strong> @Model.DietType
                </p>
                <p class="card-text mb-1">
                    <strong>Taille :</strong> @Model.Taille cm
                </p>
                <p class="card-text">
                    <strong>Poids :</strong> @Model.Poids g
                </p>
                @if (User.Identity.Name != null && User.Identity.Name.Equals(Model.OwnerName))
                {
                    <p class="card-text">
                        <strong>Visible :</strong> @Model.IsVisible
                    </p>
                }
            </div>
        </div>

        <div class="col-md-4 d-flex align-items-center justify-content-center p-3">
            <img src="/images/species/@Model.Avatar"
                 class="rounded"
                 style="width: 150px; height: 150px; object-fit: cover; display: block;" />
        </div>

    </div>
