@using BioDomes.Domains.Core
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - BioDomes.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/bundle.css" asp-append-version="true"/>
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/> *@
    @* <link rel="stylesheet" href="~/css/paragraph-custom-style.css" asp-append-version="true"/> *@
    @* <link rel="stylesheet" href="~/css/title-custom-style.css" asp-append-version="true"/> *@
    <link rel="stylesheet" href="~/BioDomes.Web.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index">
                <img class="w h-25" src="~/images/logo.webp" alt="Logo biodome" style="max-width:50px;" />
                BioDomes : Terrarium Zero
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1 ms-5 gap-5">
                    <li class="nav-item">
                        <a class="nav-link text-dark fs-5 text-decoration-underline" asp-area="" asp-page="/Index">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fs-5 text-decoration-underline" asp-area="" asp-page="/Biodomes/Biodomes">Biodomes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fs-5 text-decoration-underline" asp-area="" asp-page="/Species/Species">Espèces</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fs-5 text-decoration-underline" asp-area="" asp-page="/Equipements/Equipements">Equipements</a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown ms-auto">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                @{
                                    var avatar = User.FindFirst("Avatar")?.Value ?? "1.png";
                                }
                                <img src="~/images/avatars/@avatar"
                                     class="rounded-circle"
                                     style="width:32px; height:32px; object-fit:cover;"  alt="avatar"/>

                                <span class="text-dark">Mon compte</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end">

                                @if (User.IsInRole(Roles.Research.ToRoleName()))
                                {
                                    <li>
                                        <a class="dropdown-item"  asp-page="/Biodomes/UserBiodomes">
                                            Mes biodomes
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/Account/Edit">
                                            Modifier mon profil
                                        </a>
                                    </li>
                                }

                                @if (User.IsInRole(Roles.Admin.ToRoleName()))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-page="/Admin/Dashboard">
                                            Tableau de bord admin
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/Admin/Species">
                                            Modifier les espèces
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/Admin/Equipements">
                                            Modifier les équipements
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item"  asp-page="/Biodomes/UserBiodomes">
                                            Mes biodomes
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/Account/Edit">
                                            Modifier mon profil
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <form method="post" asp-page="/Account/Logout">
                                        <button type="submit" class="dropdown-item">
                                            Déconnexion
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-auto">
                            <a class="nav-link text-dark fs-5 text-decoration-underline" asp-page="/Account/Login">
                                Se connecter
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer ">
    <div class="container text-center">
        &copy; 2026 - BioDomes : Terrarium Zero
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>