@model BioDomes.Domains.Core.Biodome

<article class="p-3 rounded-2 d-flex flex-column" style="background-color: #d3d6d8; box-shadow: 0 2px 8px rgba(0,0,0,0.08); width: 220px; height: 360px;">
    <div style="width: 100%; height: 150px; overflow: hidden; border-radius: 6px; flex-shrink: 0;">
        <img src="images/biodomes/@Model.Image" alt="Biodome de @Model.Nom"
             style="width: 100%; height: 100%;" />
    </div>
    <a class="text-center text-decoration-none text-black mt-2" href="biodomes/@Model.Id">
        <h5 class="card-title mb-1">@Model.Nom</h5>
    </a>
    <p class="card-text text-start flex-grow-1" style="font-size: 0.875rem;">
        <strong>Nombre d'espèces : </strong> @Model.Species.Count <br/>
        <strong>Température :</strong> @Model.Temperature°C <br/>
        <strong>Humidité :</strong> @Model.Humidite g/m³ <br/>
        <strong>Etat :</strong> @Model.Etat <br/>
    </p>
    <div class="d-flex justify-content-center mt-auto">
        <a href="biodomes/@Model.Id" class="btn btn-sm btn-outline-secondary px-4">Voir</a>
    </div>
</article>