@model BioDomes.Domains.Core.Biodome

<article class="card-body">
    <a href="biodomes/@Model.Id">
    <h5 class="card-title">@Model.Nom</h5>
    </a>
    <p class="card-text">
        <strong>Nombre d'espèces : </strong> @Model._especes.Count <br/>
        <strong>Température :</strong> @Model.Temperature°C <br/>
        <strong>Humidité :</strong> @Model.Humidite g/m³ <br/>
        <strong>Etat :</strong> @Model.Etat <br/>
    </p>
</article>