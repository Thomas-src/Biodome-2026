@page "/biodomes"
@model BioDomes.Web.Pages.Biodomes.Biodomes

@{
    ViewData["Title"] = "Biodomes";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


<h1>Les biodomes </h1>
<div>
    <a class="btn btn-primary mt-2 mb-2" href="/biodomes/create">Créer</a>
</div>

<div class="d-flex flex-wrap justify-content-evenly gap-3" style="border: 1px red solid">

    @foreach (var biodome in Model.AllBiodomes)
    {
        <partial name="Shared/_BiodomeCard" model="biodome"/>
    }
</div>