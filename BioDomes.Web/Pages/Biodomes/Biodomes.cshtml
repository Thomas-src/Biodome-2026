@page "/biodomes"
@model BioDomes.Web.Pages.Biodomes.Biodomes

@{
    ViewData["Title"] = "Biodomes";
}

<partial name="Shared/_Toast" />
<partial name="_PageHeader" model='("Les biodomes en équilibre", "/Biodomes/Create")' />


<div class="card mb-4 ">
    <div class="card-header fw-semibold">Rechercher des biodomes en équilibre</div>
    <div class="card-body">
        <form method="get">
            <div class="row g-3">
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label">Température (°C)</label>
                    <div class="d-flex gap-2">
                        <input asp-for="SearchTemperatureMin" type="number" step="0.1"
                               class="form-control" placeholder="Min" />
                        <input asp-for="SearchTemperatureMax" type="number" step="0.1"
                               class="form-control" placeholder="Max" />
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label">Humidité (%)</label>
                    <div class="d-flex gap-2">
                        <input asp-for="SearchHumiditeMin" type="number" step="0.1"
                               class="form-control" placeholder="Min" />
                        <input asp-for="SearchHumiditeMax" type="number" step="0.1"
                               class="form-control" placeholder="Max" />
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="SearchEquipement" class="form-label">Équipement</label>
                    <input asp-for="SearchEquipement" type="text"
                           class="form-control" placeholder="ex: capteur CO2" />
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="SearchEspece" class="form-label">Espèce</label>
                    <input asp-for="SearchEspece" type="text"
                           class="form-control" placeholder="ex: lion" />
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-success">Rechercher</button>
                <a asp-page="/Biodomes/Biodomes" class="btn btn-outline-secondary">Réinitialiser</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.AllBiodomes.Any())
{
    <div class="alert alert-info">Aucun biodome trouvé pour ces critères.</div>
}
else
{
    <div class="row g-3">
        @foreach (var biodome in Model.AllBiodomes)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <partial name="Shared/_BiodomeCard" model="biodome" />
            </div>
        }
    </div>
}