@page "/user"
@model BioDomes.Web.Pages.Biodomes.UserBiodomesModel

@{
    ViewData["Title"] = "Vos Biodomes";
}

<partial name="Shared/_Toast" />
<partial name="_PageHeader" model='("Vos biodomes", "/Biodomes/Create")' />

@if (!Model.AllBiodomes.Any())
{
    <div class="alert alert-info">Vous n'avez pas encore créé de biodome.</div>
}
else
{
    <div class="d-flex flex-wrap justify-content-start gap-3">
        @foreach (var biodome in Model.AllBiodomes)
        {
            <partial name="Shared/_BiodomeCard" model="biodome" />
        }
    </div>
}