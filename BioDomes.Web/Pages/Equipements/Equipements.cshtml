@page "/equipements"
@model BioDomes.Web.Pages.Equipements.Equipements

@{
    ViewData["Title"] = "Equipements";
}

<partial name="Shared/_Toast" />
<partial name="_PageHeader" model='("Les équipements", "/Equipements/Create")' />
@if (User.Identity.IsAuthenticated)
{
    <h2>Vos équipements</h2>

    <section>
        @if (Model.OwnEquipements == null || Model.OwnEquipements.Count == 0)
        {
            <p>Vous n'avez crée aucun équipements</p>
        }
        else
        {
            <div class="container">
                <div class="row g-3">
                    @foreach (var eq in Model.OwnEquipements)
                    {
                        <div class="col-4 ">
                            <div class="card shadow-sm h-100">
                                <partial name="Shared/_EquipementCard" model="eq"/>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </section>

    <h2>Autres équipements disponibles</h2>
    <section>
        <div class="container">
            <div class="row g-3">
                @foreach (var eq in Model.RestEquipements)
                {
                    <div class="col-4">
                        <div class="card shadow-sm h-100">
                            <partial name="Shared/_EquipementCard" model="eq"/>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
else
{
    <h2>Tout les équipements disponibles</h2>
    <section>
        <div class="container">
            <div class="row g-3">
                @foreach (var eq in Model.RestEquipements)
                {
                    <div class="col-4">
                        <div class="card shadow-sm h-100">
                            <partial name="Shared/_EquipementCard" model="eq"/>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}