@page
@model IndexModel
@{
    ViewData["Title"] = "Accueil";
}

<section class="text-center">
    <img src="/images/logo.webp" alt="Logo Biodome" style="max-width:150px;" />

    <h1 class="display-4 mt-3">Bienvenue à Biodome</h1>
    <p class="lead">
        Biodome est un simulateur écologique immersif où vous observez et influencez
        des écosystèmes dynamiques. Chaque espèce joue un rôle clé dans l’équilibre du vivant.
    </p>
<h2>Créé par Laudot Solutions</h2>
    <p class="lead">
        Notre studio, conçoit des expériences interactives inspirées de la nature,
        combinant science et gameplay pour sensibiliser à la biodiversité.
    </p>

    <h2 class="mt-5">Biomes les plus équilibrés</h2>
</section>