@page "/Species"
@model BioDomes.Web.Pages.Species.SpeciesModel

@{
    ViewData["Title"] = "Species";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
    TempData["SuccessMessage"] = null;
}

<h1 class="text-center">Les espèces</h1>

@if (User.Identity.IsAuthenticated)
{
    
    <h2>Vos espèces :</h2>

    <div class="container">
        <a class="btn btn-sm btn-outline-primary mb-2"
           asp-page="/Species/Create">
            Créer
        </a>
    </div>

    @if (Model.OwnSpecies.Count > 0)
    {
        <div class="container">
            <div class="row g-3">
                @foreach (var espece in Model.OwnSpecies)
                {
                    <div class="col-4">
                        <div class="card shadow-sm h-100">

                            <partial name="_SpeciesCard" model="espece"/>

                            @* <div class="card-body pt-0"> *@
                            @*     <a class="btn btn-sm btn-outline-primary mb-2" *@
                            @*        asp-page="/Species/Edit" *@
                            @*        asp-route-slug="@espece.Nom"> *@
                            @*         Edit *@
                            @*     </a> *@
                            @* </div> *@

                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <p>Vous n'avez créé aucune espèce</p>
    }

    <h2>Autres espèces disponibles :</h2>
}
else
{
    <h2>Toutes les espèces disponible :</h2>
}



@if (Model.OtherSpecies.Count > 0)
{
    <div class="container">
        <div class="row g-3">
            @foreach (var espece in Model.OtherSpecies)
            {
                <div class="col-4">
                    <div class="card shadow-sm h-100">

                        <partial name="_SpeciesCard" model="espece"/>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <p>Aucune autre espèce disponible</p>
}