@page "/Species/create"
@model BioDomes.Web.Pages.Species.Create

@{
    ViewData["Title"] = "Create Species";
}

<h1 class="mb-4">Créer une espèce</h1>

<div class="container">
    <div class="row">
        <div class="col-md-6">
            
            <form method="post" enctype="multipart/form-data">
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                }
                
                <div class="mb-3">
                    <label asp-for="Species.Name" class="form-label">Nom*</label>
                    <input asp-for="Species.Name" class="form-control" />
                    <span asp-validation-for="Species.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Species.Type" class="form-label">Type*</label>
                    <select class="form-control" name="Species.Type">
                        <option value="">-- Choisir un organisme --</option>
                        @foreach (var organisme in Model.AllTypes)
                        {
                            <option value="@organisme">@organisme</option>
                        }
                    </select>
                    <span asp-validation-for="Species.Type" class="text-danger"></span>

                </div>

                <div class="mb-3">
                    <label asp-for="Species.Regime" class="form-label">Régime*</label>

                    <select class="form-control" name="Species.Regime">
                        <option value="">-- Choisir un régime --</option>
                        @foreach (var regime in Model.Regime)
                        {
                            <option value="@regime">@regime</option>
                        }
                    </select>
                    <span asp-validation-for="Species.Regime" class="text-danger"></span>

                </div>

                <div class="mb-3">
                    <label asp-for="Species.Taille" class="form-label">Taille*</label>
                    <input asp-for="Species.Taille" class="form-control" type="number" step="0.01"/>
                    <span asp-validation-for="Species.Taille" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Species.Poids" class="form-label">Poids*</label>
                    <input asp-for="Species.Poids" class="form-control" type="number" step="1"/>
                    <span asp-validation-for="Species.Poids" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Avatar*</label>
                    <input type="file" asp-for="Species.Avatar" class="form-control" />
                    <span asp-validation-for="Species.Avatar" class="text-danger"></span>
                </div>
                
                <button type="submit" class="btn btn-primary">Créer</button>
                <a href="./" class="btn btn-secondary ms-2">Annuler</a>

            </form>

        </div>
    </div>
</div>