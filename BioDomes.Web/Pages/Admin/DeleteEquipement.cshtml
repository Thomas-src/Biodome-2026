@page
@model BioDomes.Web.Pages.Admin.DeleteEquipementModel

@{
    ViewData["Title"] = "Supprimer un équipement";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Supprimer un équipement</h1>
    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Equipements">
        ← Retour
    </a>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white d-flex align-items-center gap-2">
                    <strong>Confirmation de suppression</strong>
                </div>

                <div class="card-body">
                    <p class="text-muted mb-3">
                        Vous êtes sur le point de supprimer définitivement l'équipement suivant :
                    </p>

                    <partial name="_EquipementCard" model="Model.Equipement" />

                    <div class="alert alert-warning mt-3 mb-0" role="alert">
                        <strong>Attention :</strong> Cette action est irréversible. L'équipement
                        <strong>@Model.Equipement.Name</strong> sera définitivement supprimé.
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary"
                       asp-page="/Admin/Equipements">
                        Annuler
                    </a>
                    <form method="post" asp-page-handler="Delete">
                        <input type="hidden" name="slug" value="@Model.Equipement.Name" />
                        <button type="submit" class="btn btn-danger">
                            Supprimer définitivement
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
