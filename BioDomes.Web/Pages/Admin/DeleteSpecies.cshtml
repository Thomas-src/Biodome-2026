@page "{slug:slug}"
@using BioDomes.Domains.Extensions
@model BioDomes.Web.Pages.Admin.DeleteSpeciesModel

@{
    ViewData["Title"] = "Supprimer une espèce";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Supprimer une espèce</h1>
    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/species">
        ← Retour
    </a>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white d-flex align-items-center gap-2">
                    <strong>Confirmation de suppression</strong>
                </div>

                <div class="card-body">
                    <p class="text-muted mb-3">
                        Vous êtes sur le point de supprimer définitivement l'espèce suivante :
                    </p>

                    <partial name="_SpeciesCard" model="Model.Species" />

                    <div class="alert alert-warning mt-3 mb-0" role="alert">
                        <strong>Attention :</strong> Cette action est irréversible. L'espèce
                        <strong>@Model.Species.Nom</strong> sera définitivement supprimée.
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary"
                       asp-page="/Admin/species">
                        Annuler
                    </a>
                    <form method="post" asp-page-handler="Delete">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="slug" value="@Model.Species.Nom.ToKebabCase()"/>
                        <input type="hidden" name="ownerName" value="@Model.Species.OwnerName"/>
                        <button type="submit" class="btn btn-danger">
                            Supprimer définitivement
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
