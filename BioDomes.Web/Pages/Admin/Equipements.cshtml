@page
@using BioDomes.Domains.Extensions
@model BioDomes.Web.Pages.Admin.EquipementsModel

@{
    ViewData["Title"] = "Modification des équipements";
}
<partial name="Shared/_Toast"/>
<partial name="_PageHeader" model='("Modification des équipements", "/Equipements/Create")'/>

<div class="container mb-4">
    <h2>Équipements à vérifier: @Model.EquipementsToVerify.Count</h2>

    @if (Model.EquipementsToVerify.Count > 0)
    {
        <div class="row g-3 mb-4">
            @foreach (var equipement in Model.EquipementsToVerify)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card shadow-sm h-100 border-warning">
                        <partial name="_EquipementCard" model="equipement"/>
                        <div class="card-footer d-flex flex-column flex-md-row gap-2">
                            <a class="btn btn-sm btn-outline-primary w-100 w-md-50"
                               asp-page="/Admin/EditEquipement"
                               asp-route-slug="@equipement.Name"
                               asp-route-ownerName="@equipement.OwnerName">
                                Modifier
                            </a>
                            <form method="post" asp-page-handler="MakePublic" class="w-100 w-md-50">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="name" value="@equipement.Name"/>
                                <input type="hidden" name="ownerName" value="@equipement.OwnerName"/>

                                <button type="submit" class="btn btn-sm btn-outline-success w-100">
                                    Rendre publique
                                </button>
                            </form>

                            @if (Model.EquipementsBiodomeCount[(equipement.Name, equipement.OwnerName)] == 0)
                            {
                                <a class="btn btn-sm btn-outline-danger w-100 w-md-50"
                                   asp-page="/Admin/DeleteEquipement"
                                   asp-route-slug="@equipement.Name.ToSlug()"
                                   asp-route-ownerName="@equipement.OwnerName">
                                    Supprimer
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted mb-4 text-center text-md-start">
            Aucun équipement en attente de vérification.
        </p>
    }

    <h2>Équipements vérifiés @Model.EquipementsVerified.Count</h2>

    @if (Model.EquipementsVerified.Count > 0)
    {
        <div class="row g-3 mb-4">
            @foreach (var equipement in Model.EquipementsVerified)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card shadow-sm h-100">
                        <partial name="_EquipementCard" model="equipement"/>

                        <div class="card-footer d-flex flex-column flex-md-row gap-2">

                            <a class="btn btn-sm btn-outline-primary w-100 w-md-50"
                               asp-page="/Admin/EditEquipement"
                               asp-route-slug="@equipement.Name"
                               asp-route-ownerName="@equipement.OwnerName">
                                Modifier
                            </a>
                            @if (Model.EquipementsBiodomeCount[(equipement.Name, equipement.OwnerName)] == 0)
                            {
                                <a class="btn btn-sm btn-outline-danger w-100 w-md-50"
                                   asp-page="/Admin/DeleteEquipement"
                                   asp-route-slug="@equipement.Name"
                                   asp-route-ownerName="@equipement.OwnerName">
                                    Supprimer
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted mb-4 text-center text-md-start">
            Aucun équipement vérifié.
        </p>
    }
</div>