@page
@model BioDomes.Web.Pages.User.Connect

@{
    ViewData["Title"] = "Connection";
}

<section class="rounded-4 m-auto p-3" style="background-color: aliceblue; width: 40%">
    <h1 class="title text-center">Authentification</h1>
    <form class="d-flex flex-column m-auto w-75 mt-3 gap-2">
        <div class="d-flex flex-column">
            <label class="form-label">
                Email ou username :
            </label>
            <input name="Username" class="form-control" placeholder="Ex johndoe@gmail.com"/>
            <span></span>
        </div>
        <div class="d-flex flex-column mb-1">
            <label class="form-label">
                Mot de passe :
            </label>
            <input name="password" class="form-control" type="password"/>
            <span></span>
        </div>
        <button class="btn btn-primary" >Se connecter</button>
        <a href="/user/register">Pas encore de compte ? Creer un compte</a>
    </form>
</section>